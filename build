#!/usr/bin/env bash
# Build the suite or one app using its own Makefile recipe.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
apps=(transfer queue logs)
if [[ $# -gt 1 ]]; then
  echo "Usage: $0 [transfer|queue|logs]" >&2
  exit 2
fi
if [[ $# -eq 1 ]]; then
  case "$1" in
    transfer|queue|logs) apps=("$1") ;;
    *) echo "Usage: $0 [transfer|queue|logs]" >&2; exit 2 ;;
  esac
fi

for app in "${apps[@]}"; do
  make -C "$root/apps/$app" build
done
