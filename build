#!/usr/bin/env bash
# Build the suite or one app using its own Makefile recipe.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
apps=(lazyftp service-bus-explorer log-viewer)
if [[ $# -gt 1 ]]; then
  echo "Usage: $0 [lazyftp|service-bus-explorer|log-viewer]" >&2
  exit 2
fi
if [[ $# -eq 1 ]]; then
  case "$1" in
    lazyftp|service-bus-explorer|log-viewer) apps=("$1") ;;
    *) echo "Usage: $0 [lazyftp|service-bus-explorer|log-viewer]" >&2; exit 2 ;;
  esac
fi

for app in "${apps[@]}"; do
  make -C "$root/apps/$app" build
done
