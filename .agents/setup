#!/usr/bin/env bash
set -euo pipefail

started=$SECONDS
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

go_version=1.27.3
go_sha256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
toolchain="$HOME/.local/toolchains/go$go_version"
mkdir -p "$HOME/.local/toolchains" "$HOME/.local/bin"
if [[ ! -x "$toolchain/bin/go" ]] || [[ "$("$toolchain/bin/go" version)" != "go version go$go_version linux/amd64" ]]; then
  echo "Installing Go $go_version (linux-amd64)..."
  temporary="$(mktemp -d)"
  trap 'rm -rf "$temporary"' EXIT
  curl --fail --location --retry 3 "https://go.dev/dl/go$go_version.linux-amd64.tar.gz" -o "$temporary/go.tar.gz"
  echo "$go_sha256  $temporary/go.tar.gz" | sha256sum --check -
  tar -xzf "$temporary/go.tar.gz" -C "$temporary"
  rm -rf "$toolchain"
  mv "$temporary/go" "$toolchain"
fi
for executable in go gofmt; do
  ln -sfn "$toolchain/bin/$executable" "$HOME/.local/bin/$executable"
  if command -v sudo >/dev/null && sudo -n true 2>/dev/null; then
    sudo -n ln -sfn "$HOME/.local/bin/$executable" "/usr/local/bin/$executable"
  fi
done
profile_marker='# lazyftp user-local toolchain'
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nexport PATH="$HOME/.local/bin:$PATH"\n' "$profile_marker" >> "$HOME/.bash_profile"
fi
export PATH="$HOME/.local/bin:$PATH"
go version
echo "Go ready after $((SECONDS - started))s: $toolchain/bin/go"

for module_file in apps/*/go.mod lib/*/go.mod; do
  [[ -f "$module_file" ]] || continue
  echo "Downloading Go dependencies for $module_file..."
  GOWORK=off go -C "$(dirname "$module_file")" mod download
done

echo 'Preparing terminal smoke-test dependencies...'
if ! command -v uv >/dev/null; then
  echo 'uv is required; install it from https://docs.astral.sh/uv/getting-started/installation/.' >&2
  exit 1
fi

for requirements in apps/*/scripts/requirements.txt; do
  [[ -f "$requirements" ]] || continue
  environment="${requirements%/scripts/requirements.txt}/.venv"
  echo "Preparing terminal-test environment: $environment..."
  if [[ ! -x "$environment/bin/python" ]]; then
    uv venv "$environment"
  fi
  uv pip install --python "$environment/bin/python" -r "$requirements"
done

echo 'Preparing pinned browser-terminal preview helper...'
ttyd_version=1.7.7
ttyd_sha256=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
ttyd_target="$HOME/.local/toolchains/ttyd-$ttyd_version/ttyd"
if [[ ! -f "$ttyd_target" ]] || ! printf '%s  %s\n' "$ttyd_sha256" "$ttyd_target" | sha256sum --check --status; then
  (
    download="$(mktemp)"
    trap 'rm -f "$download"' EXIT
    curl --fail --silent --show-error --location --retry 3 \
      "https://github.com/tsl0922/ttyd/releases/download/$ttyd_version/ttyd.x86_64" -o "$download"
    printf '%s  %s\n' "$ttyd_sha256" "$download" | sha256sum --check -
    install -D -m 0755 "$download" "$ttyd_target"
  )
fi
ln -sfn "$ttyd_target" "$HOME/.local/bin/ttyd"
ttyd --version

echo 'Preparing pinned direct-process FTP/Blob/S3 lab dependencies...'
if ! command -v node >/dev/null || ! command -v npm >/dev/null; then
  echo 'Node.js and npm are required for the pinned local Azurite emulator.' >&2
  exit 1
fi
python3 apps/transfer/scripts/lab.py install-rclone
python3 apps/transfer/scripts/lab.py install-s3
npm ci --prefix apps/transfer/lab --ignore-scripts --no-audit --no-fund
echo 'Lab dependencies ready. Run make -C apps/transfer lab-up lab-seed inside the orb (no Docker required).'
echo "Setup complete in $((SECONDS - started))s."
